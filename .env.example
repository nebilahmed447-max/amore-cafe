NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Google Maps Platform Routes API (server-side only)
GOOGLE_MAPS_API_KEY=your_server_side_google_maps_routes_api_key

# Optional routing fallback. If Google Routes is unavailable, V44 falls back to OSRM.
# For production/high traffic, set this to your own OSRM server.
OSRM_ROUTING_URL=https://router.project-osrm.org
